{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [ "${mod_author}" ],
    "contact": {
        "homepage": "https://github.com/Stein-N/Resource-Config-API",
        "sources": "https://github.com/Stein-N/Resource-Config-API",
        "issues": "https://github.com/Stein-N/Resource-Config-API/issues"
    },
    "license": "${mod_license}",
    "icon": "icon_fabric.png",
    "environment": "*",
    "accesswidener": "${mod_id}.accesswidener",
    "entrypoints": {
        "main": [
          "net.morthen.resourceconfigapi.ResourceConfig"
        ],
        "client": [
          "net.morthen.resourceconfigapi.ResourceConfigClient"
        ],
        "modmenu": [
          "net.morthen.resourceconfigapi.ResourceModMenuCompat"
        ]
    },
    "mixins": [ "${mod_id}.mixins.json" ],
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    },
    "custom": {
        "modmenu": {
            "badges": ["library"]
        }
    }
}